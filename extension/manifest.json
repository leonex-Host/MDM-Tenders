{
    "manifest_version": 3,
    "name": "MDM Extension",
    "version": "1.0.0",
    "icons": {
        "16": "icons/icon.png",
        "48": "icons/icon.png",
        "128": "icons/icon.png"
    },
    "description": "Locally triggers Google Chrome to scrape TenderOnTime flawlessly and uploads the data to the MDM Dashboard.",
    "permissions": [
        "storage",
        "tabs",
        "activeTab",
        "scripting",
        "alarms"
    ],
    "host_permissions": [
        "https://www.tendersontime.com/*",
        "https://www.tenderdetail.com/*",
        "https://www.biddetail.com/*",
        "https://bidplus.gem.gov.in/*",
        "https://www.tender247.com/*",
        "https://www.google.com/*",
        "*://*.onrender.com/*",
        "*://localhost/*"
    ],
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.tendersontime.com/*"
            ],
            "js": [
                "content_scripts/tenderontime.js"
            ],
            "run_at": "document_end"
        },
        {
            "matches": [
                "https://www.tenderdetail.com/*"
            ],
            "js": [
                "content_scripts/tenderdetail.js"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "https://www.biddetail.com/*"
            ],
            "js": [
                "content_scripts/biddetail.js"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "https://bidplus.gem.gov.in/*"
            ],
            "js": [
                "content_scripts/gem.js"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "https://www.tender247.com/*"
            ],
            "js": [
                "content_scripts/tender247.js"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "https://www.google.com/*"
            ],
            "js": [
                "content_scripts/google.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "action": {
        "default_popup": "popup/popup.html",
        "default_title": "MDM Scraper Control"
    }
}
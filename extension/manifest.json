{
    "manifest_version": 3,
    "name": "MDM Extension",
    "version": "1.0.0",
    "icons": {
        "16": "icons/icon.png",
        "48": "icons/icon.png",
        "128": "icons/icon.png"
    },
    "description": "Locally triggers Google Chrome to scrape TenderOnTime flawlessly and uploads the data to the MDM Dashboard.",
    "permissions": [
        "storage",
        "tabs",
        "activeTab",
        "scripting",
        "alarms"
    ],
    "host_permissions": [
        "<all_urls>",
        "https://www.tendersontime.com/*",
        "https://www.google.com/*",
        "*://*.tender247.com/*",
        "*://*.biddetail.com/*",
        "*://*.tenderdetail.com/*",
        "*://gem.gov.in/*",
        "*://*.onrender.com/*",
        "*://localhost/*",
        "*://mdm-tenders.vercel.app/*"
    ],
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.tendersontime.com/*"
            ],
            "js": [
                "content_scripts/tenderontime.js"
            ],
            "run_at": "document_end"
        },
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content_scripts/google.js"
            ],
            "run_at": "document_end"
        },
        {
            "matches": [
                "*://*.tender247.com/*"
            ],
            "js": [
                "content_scripts/tender247.js"
            ],
            "run_at": "document_end"
        },
        {
            "matches": [
                "*://*.biddetail.com/*"
            ],
            "js": [
                "content_scripts/biddetail.js"
            ],
            "run_at": "document_end"
        },
        {
            "matches": [
                "*://*.tenderdetail.com/*"
            ],
            "js": [
                "content_scripts/tenderdetail.js"
            ],
            "run_at": "document_end"
        },
        {
            "matches": [
                "*://gem.gov.in/*",
                "*://bidplus.gem.gov.in/*"
            ],
            "js": [
                "content_scripts/gem.js"
            ],
            "run_at": "document_end"
        },
        {
            "matches": [
                "*://*.onrender.com/*",
                "*://localhost/*",
                "*://mdm-tenders.vercel.app/*"
            ],
            "js": [
                "content_scripts/dashboard.js"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content_scripts/bell.js"
            ],
            "run_at": "document_end"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "icons/bell.png",
                "icons/icon.png"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "action": {
        "default_popup": "popup/popup.html",
        "default_title": "MDM Scraper Control"
    }
}
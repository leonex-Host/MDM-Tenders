{
  "manifest_version": 3,
  "name": "MDM Extension",
  "version": "1.2.0",
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "description": "Locally triggers Google Chrome to scrape TenderOnTime flawlessly and uploads the data to the MDM Dashboard.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://www.tendersontime.com/*",
    "https://www.google.com/*",
    "*://*.onrender.com/*",
    "*://localhost/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.tendersontime.com/*"
      ],
      "js": [
        "content_scripts/tenderontime.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://www.google.com/search*",
        "https://www.google.com/url*"
      ],
      "js": [
        "content_scripts/google.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "exclude_matches": [
        "https://www.google.com/search*",
        "https://www.google.com/url*",
        "https://www.tendersontime.com/*"
      ],
      "js": [
        "content_scripts/detail.js"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "MDM Scraper Control"
  }
}
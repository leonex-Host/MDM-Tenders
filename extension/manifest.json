{
    "manifest_version": 3,
    "name": "MDM Tender Scraper Agent",
    "version": "1.0.0",
    "description": "Locally triggers Google Chrome to scrape TenderOnTime flawlessly and uploads the data to the MDM Dashboard.",
    "permissions": [
        "storage",
        "tabs",
        "activeTab",
        "scripting",
        "alarms"
    ],
    "host_permissions": [
        "https://www.tendersontime.com/*",
        "*://*.onrender.com/*",
        "*://localhost/*"
    ],
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.tendersontime.com/*"
            ],
            "js": [
                "content_scripts/tenderontime.js"
            ],
            "run_at": "document_end"
        }
    ],
    "action": {
        "default_popup": "popup/popup.html",
        "default_title": "MDM Scraper Control"
    }
}